{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "demoAccessKey": {
      "value": "${AZURE_DEMO_ACCESS_KEY}"
    },
    "proxySecret": {
      "value": "${AZURE_PROXY_SECRET}"
    },
    "enablePrivateArtifacts": {
      "value": "true"
    },
    "enableCosmosPrivateEndpoint": {
      "value": "true"
    },
    "lockDownCosmosPublicAccess": {
      "value": "true"
    },
    "vnetAddressPrefix": {
      "value": "10.42.0.0/24"
    },
    "functionIntegrationSubnetPrefix": {
      "value": "10.42.0.0/27"
    },
    "privateEndpointSubnetPrefix": {
      "value": "10.42.0.32/27"
    },
    "foundryProjectName": {
      "value": "minutes-studio"
    }
  }
}
