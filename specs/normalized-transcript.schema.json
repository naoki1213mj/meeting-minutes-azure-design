{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/normalized-transcript.schema.json",
  "title": "NormalizedTranscript",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "tenantId", "locale", "durationMilliseconds", "phrases", "speakers"],
  "properties": {
    "jobId": { "type": "string" },
    "tenantId": { "type": "string" },
    "locale": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speechApi": { "type": "string" },
        "apiVersion": { "type": "string" },
        "rawTranscriptBlobUri": { "type": "string" }
      }
    },
    "durationMilliseconds": { "type": "integer", "minimum": 0 },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["speakerLabel", "phraseCount", "representativePhrases"],
        "properties": {
          "speakerLabel": { "type": "string" },
          "displayName": { "type": ["string", "null"] },
          "phraseCount": { "type": "integer", "minimum": 0 },
          "representativePhrases": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offsetMilliseconds", "startTimeText", "text"],
              "properties": {
                "offsetMilliseconds": { "type": "integer", "minimum": 0 },
                "startTimeText": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "phrases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phraseId", "speakerLabel", "offsetMilliseconds", "durationMilliseconds", "startTimeText", "text"],
        "properties": {
          "phraseId": { "type": "string" },
          "speakerLabel": { "type": "string" },
          "displayName": { "type": ["string", "null"] },
          "offsetMilliseconds": { "type": "integer", "minimum": 0 },
          "durationMilliseconds": { "type": "integer", "minimum": 0 },
          "startTimeText": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$" },
          "endTimeText": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$" },
          "text": { "type": "string" },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
