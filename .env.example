# Common
ENVIRONMENT=local
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER_NAME=audio
AZURE_STORAGE_CONTAINER_RAW_AUDIO=raw-audio
AZURE_STORAGE_CONTAINER_TRANSCRIPT=transcript
AZURE_STORAGE_CONTAINER_MINUTES=minutes
UPLOAD_SAS_TTL_MINUTES=30
# Must cover Speech service fetch + retries when using Fast Transcription audioUrl.
SPEECH_READ_SAS_TTL_MINUTES=90

# Cosmos DB
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE_NAME=meeting-minutes
AZURE_COSMOS_JOBS_CONTAINER_NAME=jobs
AZURE_COSMOS_CONTAINER_JOBS=jobs
AZURE_COSMOS_CONTAINER_SPEAKER_MAPPINGS=speakerMappings
AZURE_COSMOS_CONTAINER_ACTION_ITEMS=actionItems
AZURE_COSMOS_CONTAINER_AUDIT_EVENTS=auditEvents

# Azure Speech in Foundry Tools
AZURE_SPEECH_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
AZURE_SPEECH_API_VERSION=2025-10-15
AZURE_SPEECH_USE_ENTRA_ID=true
AZURE_SPEECH_REQUEST_TIMEOUT_SECONDS=480
# Only for local fallback. Do not commit real secrets.
AZURE_SPEECH_KEY=

# Azure OpenAI in Microsoft Foundry Models
# Use the v1 API. Do not add dated api-version parameters for new code.
AZURE_OPENAI_BASE_URL=https://<resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_USE_ENTRA_ID=true
AZURE_OPENAI_DEPLOYMENT_CHUNK_SUMMARY=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_FINAL_MERGE=gpt-5.4
# Direct minutes generation uses gpt-5.4-mini for "fast" and gpt-5.4 for "quality".
# Chunk summary mode is retained as automatic fallback.
AZURE_OPENAI_MAX_PARALLEL_CHUNKS=4
# Only for local fallback. Do not commit real secrets.
AZURE_OPENAI_API_KEY=

# Demo access gate (customer demo)
# Shared key customers type to access the app. Leave empty for local dev to disable the gate.
# Provide a long random value in real deployments (e.g. `openssl rand -base64 24`).
DEMO_ACCESS_KEY=
# Secret the frontend reverse proxy injects when calling the Function App.
# Must be different from DEMO_ACCESS_KEY and is never sent to the browser.
MEETING_MINUTES_PROXY_SECRET=
# Functions origin the frontend proxy forwards /api/* to (deployed frontend only).
API_ORIGIN=

# Input limits
# Normal UX gate is stricter than the service limit to keep latency predictable.
NORMAL_MAX_AUDIO_FILE_SIZE_BYTES=314572800
HARD_MAX_AUDIO_FILE_SIZE_BYTES=524288000
MAX_AUDIO_DURATION_SECONDS_WITH_DIARIZATION=7200
DEFAULT_LOCALE=ja-JP
DEFAULT_MAX_SPEAKERS=8

# Frontend
VITE_API_BASE_URL=http://localhost:7071
VITE_AAD_CLIENT_ID=
VITE_AAD_TENANT_ID=
VITE_AAD_REDIRECT_URI=http://localhost:5173
VITE_DEV_TENANT_ID=local-tenant
VITE_DEV_USER_ID=local-user
