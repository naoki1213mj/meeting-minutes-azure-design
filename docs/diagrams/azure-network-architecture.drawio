        <mxCell id="note-security" value="Key security posture&lt;br&gt;* Storage account key is not used&lt;br&gt;* Data access uses managed identity + RBAC&lt;br&gt;* Ingest remains public only for upload and AI media fetch&lt;br&gt;* Artifacts and Cosmos are private after verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9CC;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="60" y="900" width="420" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Traffic legend&lt;br&gt;Red: public HTTPS 443&lt;br&gt;Purple: AIServices HTTPS 443&lt;br&gt;Blue: Private Endpoint HTTPS 443&lt;br&gt;Blue dashed: Private DNS VNet link&lt;br&gt;Gray dashed: telemetry only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;fontSize=13;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="520" y="900" width="380" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="rollout" value="Rollout order&lt;br&gt;1. enablePrivateArtifacts = true&lt;br&gt;2. enableCosmosPrivateEndpoint = true&lt;br&gt;3. Verify Function App private connectivity&lt;br&gt;4. lockDownCosmosPublicAccess = true&lt;br&gt;CU remains explicit experimental route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#FFB900;fontSize=13;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" parent="1" vertex="1">
